<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DevelApp.JsonSchemaBuilder</AssemblyName>
    <RootNamespace>DevelApp.JsonSchemaBuilder</RootNamespace>
    <Authors>Lars Shakya Buch-Jepsen</Authors>
    <Company>DevelApp Denmark (CVR 33211740)</Company>
    <Copyright>Copyright © DevelApp.ai ApS 2020-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DevelApp-ai/JsonSchemaBuilder</RepositoryUrl>
    <Description>Simple Json Schema builder for Manatee.Json to make it faster to combine in code</Description>
    <Version>1.0.21</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.SmartEnum" Version="2.0.0" />
    <PackageReference Include="DevelApp.Utility" Version="1.0.6" />
    <PackageReference Include="manatee.json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
