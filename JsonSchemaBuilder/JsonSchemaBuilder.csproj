<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DevelApp.JsonSchemaBuilder</AssemblyName>
    <RootNamespace>DevelApp.JsonSchemaBuilder</RootNamespace>
    <Authors>Lars Shakya Buch-Jepsen</Authors>
    <Company>DevelApp Denmark (CVR 33211740)</Company>
    <Copyright>Copyright © DevelApp.ai ApS 2020-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DevelApp-ai/JsonSchemaBuilder</RepositoryUrl>
    <Description>Simple Json Schema builder for json-everything (JsonSchema.Net) and System.Text.Json to make it faster to combine in code</Description>
    <Version>2.0.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.SmartEnum" Version="2.0.0" />
    <PackageReference Include="DevelApp.Utility" Version="1.0.6" />
    <!-- JsonSchema.Net 9.6.0 + System.Text.Json 10.0.5 is the coherent stack for
         netstandard2.0 consumers on .NET 8: the 9.7.0 chain (Json.More.Net 3.1.0)
         requires System.Text.Json 11, whose internal serializer contracts break
         JsonSchema.FromText at runtime on a .NET 8 host -->
    <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
